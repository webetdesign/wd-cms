{
    "name": "webetdesign/wd-cms",
    "type": "symfony-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "Web&Design",
            "homepage": "https://www.webetdesign.com"
        }
    ],
    "require": {
        "php": "^7.2.5 || ^8.0",
        "doctrine/common": "^3.0.3",
        "mailjet/mailjet-apiv3-php": "^1.4",
        "doctrine/doctrine-bundle": "^2.0",
        "doctrine/inflector": "^1.1 || ^2.0",
        "doctrine/orm": "^2.6",
        "sonata-project/block-bundle": "^4.0",
        "sonata-project/admin-bundle": "^4.0",
        "sonata-project/formatter-bundle": "^5.0",
        "sonata-project/media-bundle": "^4.0",
        "stof/doctrine-extensions-bundle": "^1.3",
        "symfony/asset": "^5.4",
        "symfony/config": "^5.4",
        "symfony/console": "^5.4",
        "symfony/dependency-injection": "^5.4",
        "symfony/doctrine-bridge": "^5.4",
        "symfony/event-dispatcher": "^5.4",
        "symfony/expression-language": "^5.4",
        "symfony/form": "^5.4",
        "symfony/framework-bundle": "^5.4",
        "symfony/http-foundation": "^5.4",
        "symfony/http-kernel": "^5.4",
        "symfony/options-resolver": "^5.4",
        "symfony/property-access": "^5.4",
        "symfony/routing": "^5.4",
        "symfony/security-acl": "^3.0",
        "symfony/security-bundle": "^5.4",
        "symfony/security-core": "^5.4",
        "symfony/security-csrf": "^5.4",
        "symfony/templating": "^5.4",
        "symfony/translation": "^5.4",
        "symfony/twig-bridge": "^5.4",
        "symfony/twig-bundle": "^5.4",
        "symfony/validator": "^5.4",
        "twig/twig": "^3.0.4"
    },
    "require-dev": {
        "symfony/filesystem": "^5.4",
        "symfony/phpunit-bridge": "^5.4",
        "symfony/yaml": "^5.4"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "WebEtDesign\\CmsBundle\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/webetdesign/wd-media-bundle"
        },
        {
            "type": "vcs",
            "url": "https://github.com/webetdesign/wd-seo-bundle"
        }
    ]
}
