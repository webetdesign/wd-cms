{
    "name": "webetdesign/wd-cms",
    "type": "symfony-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "Web&Design",
            "homepage": "https://www.webetdesign.com"
        }
    ],
    "repositories": [
        {
            "type": "git",
